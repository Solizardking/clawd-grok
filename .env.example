# 🦞 Clawd Grok — Environment Configuration
# Copy this file to .env and fill in your values.

# === xAI Grok (AI Agent Brain) ===
# Required: xAI Grok API key for agent reasoning and execution
GROK_API_KEY=xai-your-api-key-here

# Optional: Custom API endpoint
# GROK_BASE_URL=https://api.x.ai/v1

# Optional: Grok model override (default: grok-4.3)
# Grok options: grok-4.3, grok-4.20-non-reasoning, grok-4.20-multi-agent-0309, grok-4.20-0309-reasoning, grok-3-mini
# GROK_MODEL=grok-4.3

# Optional: Max tokens per response
# GROK_MAX_TOKENS=16384

# === Solana RPC ===
# Required: Solana RPC endpoint (mainnet-beta)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Recommended: Use a private RPC provider for better reliability
# Helius:  https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://your-quicknode-endpoint.solana.quiknode.pro/
# Triton:  https://your-triton-endpoint

# === Phoenix DEX ===
# Phoenix perpetuals API endpoint
PHOENIX_API_URL=https://perp-api.phoenix.trade

# Optional: Phoenix API key for authenticated access
# PHOENIX_API_KEY=your-api-key

# === Solana Wallet ===
# Private key for the trading wallet (base58 encoded)
# WARNING: Never commit this to version control!
# SOLANA_PRIVATE_KEY=your-base58-private-key

# === Telegram Remote Control (Optional) ===
# TELEGRAM_BOT_TOKEN=your-bot-token-here