# 🦞 Clawd Grok — Environment Configuration
# Copy this file to .env and fill in your values.

# === xAI Grok (AI Agent Brain) ===
# Get your API key at: https://console.x.ai
XAI_API_KEY=xai-your-key-here
GROK_API_KEY=xai-your-key-here

# API endpoint (defaults to xAI)
GROK_BASE_URL=https://api.x.ai/v1

# Optional: Grok model override (default: grok-4.3)
# Available: grok-4.3, grok-4.20-non-reasoning, grok-4.20-multi-agent-0309, grok-4.20-0309-reasoning, grok-3-mini
GROK_MODEL=grok-4.3

# Optional: Max tokens per response (default: 16384)
GROK_MAX_TOKENS=16384

# === Solana Tracker (RPC + Data) ===
# Sign up at: https://www.solanatracker.io
# Falls back to SOLANA_RPC_URL if not configured
SOLANA_TRACKER_API_KEY=your-solanatracker-api-key
SOLANA_TRACKER_RPC_URL=https://rpc-mainnet.solanatracker.io/?api_key=your-rpc-key
SOLANA_TRACKER_WSS_URL=wss://rpc-mainnet.solanatracker.io/?api_key=your-rpc-key
SOLANA_TRACKER_URL=https://data.solanatracker.io

# === Solana RPC (fallback if Solana Tracker not configured) ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === Phoenix DEX ===
# Phoenix perpetuals API endpoint (default shown)
PHOENIX_API_URL=https://perp-api.phoenix.trade

# Optional: Phoenix API key for authenticated access
# PHOENIX_API_KEY=your-phoenix-api-key

# === Solana Wallet ===
# Private key for the trading wallet (base58 encoded)
# WARNING: Never commit this to version control!
# SOLANA_PRIVATE_KEY=your-base58-private-key

# === Telegram Remote Control (Optional) ===
# Create a bot with @BotFather: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token